<dataset type="EDDTableFromMultidimNcFiles" datasetID="DFO_MEDS_BUOYS_HISTORIC" active="true">
  <reloadEveryNMinutes>10080</reloadEveryNMinutes>
  <fileDir>/datasets/DFO_MEDS_BUOYS_HISTORIC/</fileDir>
  <fileNameRegex>.*\.nc</fileNameRegex>
  <recursive>false</recursive>
  <metadataFrom>last</metadataFrom>
  <fileTableInMemory>false</fileTableInMemory>
  <addAttributes>
    <att name="title">Historic data from Environment and Climate Change Canada buoys</att>
    <att name="summary">Data from a local source.</att>
    <att name="institution">DFO MEDS</att>
    <att name="infoUrl">http://www.meds-sdmm.dfo-mpo.gc.ca/isdm-gdsi/waves-vagues/formats-eng.html#CSV</att>
    <att name="sourceUrl">(local files)</att>
    <att name="cdm_data_type">TimeSeries</att>
  </addAttributes>
  <dataVariable>
    <sourceName>STN_ID</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>time</sourceName>
    <dataType>double</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>Q_FLAG</sourceName>
    <dataType>byte</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>latitude</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>longitude</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>water_depth</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>VCAR</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>VTPK</sourceName>
    <dataType>float</dataType>
  </dataVariable>
</dataset>
