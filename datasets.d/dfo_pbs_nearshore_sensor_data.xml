<dataset type="EDDTableFromAsciiFiles" datasetID="dfo_pbs_nearshore_sensor_data" active="true">
    <reloadEveryNMinutes>10080</reloadEveryNMinutes>
    <updateEveryNMillis>10000</updateEveryNMillis>
    <fileDir>/datasets/dfo_pbs_nearshore_sensor_data_flagged/</fileDir>
    <fileNameRegex>.*_flagged\.csv</fileNameRegex>
    <recursive>true</recursive>
    <pathRegex>.*</pathRegex>
    <metadataFrom>last</metadataFrom>
    <charset>UTF-8</charset>
    <columnNamesRow>1</columnNamesRow>
    <firstDataRow>2</firstDataRow>
    <standardizeWhat>0</standardizeWhat>
    <sortedColumnSourceName>date_time_UTC</sortedColumnSourceName>
    <sortFilesBySourceNames>date_time_UTC</sortFilesBySourceNames>
    <fileTableInMemory>false</fileTableInMemory>
    <accessibleViaFiles>true</accessibleViaFiles>
    <!-- sourceAttributes>
    </sourceAttributes -->
    <!-- Please specify the actual cdm_data_type (TimeSeries?) and related info below, for example...
        <att name="cdm_timeseries_variables">station_id, longitude, latitude</att>
        <att name="subsetVariables">station_id, longitude, latitude</att>
    -->
    <addAttributes>
        <att name="cdm_data_type">TimeSeries</att>
        <att name="cdm_timeseries_variables">source_file,instrument_model,instrument_serial_number,station,longitude,latitude,depth</att>
        <att name="Conventions">COARDS, CF-1.6, ACDD-1.3</att>
        <att name="creator_name">dfo_pbs</att>
        <att name="infoUrl">https://gitlab.com/dfo-msea/sensor-data-s3-uploader/sensor-data-nearshore-pbs</att>
        <att name="institution">dfo_pbs</att>
        <att name="keywords">conductivity, conductivity_mS_cm, currents, data, date, density, department, depth, depth_m, dfo, earth, Earth Science &gt; Oceans &gt; Salinity/Density &gt; Conductivity, Earth Science &gt; Oceans &gt; Salinity/Density &gt; Salinity, electrical, fisheries, flag, index, instrument, instrument_model, latitude, longitude, model, neashore, ocean, oceans, pbs, practical, qc_flag, quality, row, row_index, salinity, salinity_psu, science, sea, sea_water_electrical_conductivity, sea_water_practical_salinity, seawater, sec, sensors, temp_degC, temperature, time, timeseries, velocity, velocity_m_sec, water</att>
        <att name="keywords_vocabulary">GCMD Science Keywords</att>
        <att name="license">[standard]</att>
        <att name="sourceUrl">(local files)</att>
        <att name="standard_name_vocabulary">CF Standard Name Table v70</att>
        <att name="subsetVariables">source_file, instrument_model,station,instrument_serial_number,qc_flag</att>
        <att name="summary">Department of Fisheries and Oceans (DFO) PBS Nearshore sensor data. Read from the *_flagged.csv files of the sensor-data-nearshore-pbs repository (the repository's .nc files carry truncated timestamps).</att>
        <att name="title">DFO PBS Nearshore Sensors Timeseries</att>
    </addAttributes>
        <dataVariable>
        <sourceName>***fileName,(.*)\.csv,1</sourceName>
        <destinationName>source_file</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="ioos_category">Identifier</att>
            <att name="long_name">Source File</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>***fileName,(.*)_S\d+_.*,1</sourceName>
        <destinationName>station</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="cf_role">timeseries_id</att>
            <att name="ioos_category">Identifier</att>
            <att name="long_name">Station</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>instrument_model</sourceName>
        <destinationName>instrument_model</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">Instrument Model</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>***fileName,.*_(S\d+)_.*,1</sourceName>
        <destinationName>instrument_serial_number</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="ioos_category">Identifier</att>
            <att name="long_name">Instrument Serial Number</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>latitude_dd</sourceName>
        <destinationName>latitude</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="colorBarMaximum" type="double">90.0</att>
            <att name="colorBarMinimum" type="double">-90.0</att>
            <att name="ioos_category">Location</att>
            <att name="long_name">Latitude</att>
            <att name="standard_name">latitude</att>
            <att name="units">degrees_north</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>longitude_dd</sourceName>
        <destinationName>longitude</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="colorBarMaximum" type="double">180.0</att>
            <att name="colorBarMinimum" type="double">-180.0</att>
            <att name="ioos_category">Location</att>
            <att name="long_name">Longitude</att>
            <att name="standard_name">longitude</att>
            <att name="units">degrees_east</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>date_time_UTC</sourceName>
        <destinationName>time</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="ioos_category">Time</att>
            <att name="long_name">Date Time</att>
            <att name="standard_name">time</att>
            <att name="time_precision">1970-01-01T00:00:00Z</att>
            <att name="units">yyyy-MM-dd HH:mm:ssxxx</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>depth_m</sourceName>
        <destinationName>depth</destinationName>
        <dataType>byte</dataType>
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="colorBarMaximum" type="double">8000.0</att>
            <att name="colorBarMinimum" type="double">-8000.0</att>
            <att name="colorBarPalette">TopographyDepth</att>
            <att name="ioos_category">Location</att>
            <att name="long_name">Depth</att>
            <att name="standard_name">depth</att>
            <att name="units">m</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>temp_degC</sourceName>
        <destinationName>temp</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="ioos_category">Temperature</att>
            <att name="long_name">Sea Water Temperature</att>
            <att name="standard_name">sea_water_temperature</att>
            <att name="units">degree_C</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>salinity_psu</sourceName>
        <destinationName>salinity</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="ioos_category">Salinity</att>
            <att name="long_name">Sea Water Practical Salinity</att>
            <att name="standard_name">sea_water_practical_salinity</att>
            <att name="units">1e-3</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>conductivity_mS_cm</sourceName>
        <destinationName>conductivity</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="ioos_category">Salinity</att>
            <att name="long_name">Sea Water Electrical Conductivity</att>
            <att name="standard_name">sea_water_electrical_conductivity</att>
            <att name="units">mS/cm</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>velocity_m_sec</sourceName>
        <destinationName>velocity</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="ioos_category">Physical Oceanography</att>
            <att name="long_name">Speed of Sound in Sea Water</att>
            <att name="standard_name">speed_of_sound_in_sea_water</att>
            <att name="units">m/s</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>qc_flag</sourceName>
        <destinationName>qc_flag</destinationName>
        <dataType>int</dataType>
        <addAttributes>
            <att name="ioos_category">Quality</att>
            <att name="long_name">QC Flag</att>
            <att name="flag_values" type="intList">1 2 3 4 9</att>
            <att name="flag_meanings">GOOD UNKNOWN SUSPECT FAIL MISSING</att>
        </addAttributes>
    </dataVariable>
</dataset>
