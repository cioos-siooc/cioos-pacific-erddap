<dataset type="EDDTableFromMultidimNcFiles" datasetID="IOS_CUR_Moorings" active="true">
  <reloadEveryNMinutes>10080</reloadEveryNMinutes>
  <fileDir>/datasets/IOS_CUR_Moorings/</fileDir>
  <fileNameRegex>.*\.nc</fileNameRegex>
  <recursive>false</recursive>
  <metadataFrom>last</metadataFrom>
  <fileTableInMemory>false</fileTableInMemory>
  <addAttributes>
    <att name="title">IOS Moored Current Meter Data</att>
    <att name="summary">This dataset contains observations made by the Institute of Ocean Sciences of Fisheries and Oceans (DFO) using current meters mounted on moorings. The moorings were deployed by DFO and partner organizations between 1965 to present. Variables present in the dataset include Current speed and direction, Temperature, Depth, and Pressure as a timeseries. For any questions please contact (DFO.PAC.SCI.IOSData-DonneesISO.SCI.PAC.MPO@dfo-mpo.gc.ca).</att>
    <att name="institution">Institute of Ocean Sciences</att>
    <att name="infoUrl">???</att>
    <att name="sourceUrl">(local files)</att>
    <att name="cdm_data_type">TimeSeries</att>
  </addAttributes>
  <dataVariable>
    <sourceName>profile</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>filename</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>country</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <!-- DFO's files call it deployment_mission_id (dfo-bucket, every file, 2026-11) -->
    <sourceName>deployment_mission_id</sourceName>
    <destinationName>mission_id</destinationName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>scientist</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>project</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>agency</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>platform</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>instrument_type</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>instrument_model</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>instrument_serial_number</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>geographic_area</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>event_number</sourceName>
    <dataType>String</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>latitude</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>longitude</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>time</sourceName>
    <dataType>double</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>PRESPR01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>instrument_depth</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>depth</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>TEMPPR01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>LCEWEL01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>LCNSEL01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>LRZASP01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>LCSAEL01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>LCDAEL01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <!-- in DFO's files but not served before the switch to them (2026-11); units and standard names come from the files -->
  <dataVariable>
    <sourceName>TEMPPR02</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>TEMPPR03</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>PSLTZZ01</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>ODSDM021</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>SIGTEQST</sourceName>
    <dataType>float</dataType>
  </dataVariable>
  <dataVariable>
    <sourceName>HEADCM01</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Heading</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>PTCHEI01</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Pitch</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>ROLLEI01</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Roll</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>ISCMBMA1</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Signal Intensity, Beam 1</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>ISCMBMA2</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Signal Intensity, Beam 2</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>ISCMBMA3</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Signal Intensity, Beam 3</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>SVELCV01</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Speed of Sound in Sea Water</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>SVELCV02</sourceName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="long_name">Speed of Sound in Sea Water (2)</att>
    </addAttributes>
  </dataVariable>
</dataset>
