<dataset type="EDDTableFromMultidimNcFiles" datasetID="MichaelaMaier_CTD" active="true">
  <reloadEveryNMinutes>10080</reloadEveryNMinutes>
  <fileDir>/datasets/MichaelaMaier_CTD/</fileDir>
  <fileNameRegex>.*\.nc</fileNameRegex>
  <recursive>false</recursive>
