<dataset type="EDDTableFromMultidimNcFiles" datasetID="IOS_CTD_Profiles" active="true">
  <reloadEveryNMinutes>10080</reloadEveryNMinutes>
  <fileDir>/datasets/IOS_CTD_Profiles/</fileDir>
  <fileNameRegex>.*\.nc</fileNameRegex>
  <recursive>false</recursive>
