  <addAttributes>
    <att name="title">IOS CTD Profile Data</att>
    <att name="summary">This dataset contains observations made by the Institute of Ocean Sciences of Fisheries and Oceans (DFO) using CTDs mounted on rosettes. The CTDs were deployed by DFO and partner organizations on scientific cruises between 1968 to present. Variables present in the dataset include Temperature, Salinity, Oxygen, Conductivity, Depth, and Pressure. For any questions please contact (DFO.PAC.SCI.IOSData-DonneesISO.SCI.PAC.MPO@dfo-mpo.gc.ca).</att>
    <att name="institution">Institute of Ocean Sciences</att>
    <att name="infoUrl">???</att>
    <att name="sourceUrl">(local files)</att>
    <att name="cdm_data_type">Profile</att>
  </addAttributes>
