# Env file for the erddap-restore-agent service in docker-compose.local.yml.
#
# These values MUST match ../cioos-pacific-bucket/.env exactly (same bucket,
# same shared token) — copy them from there rather than inventing new ones.
# Copy this file to restore-agent.env and fill in real values:
#
#   cp restore-agent.env.sample restore-agent.env
#
# restore-agent.env is gitignored — never commit real credentials.

# Reachable via the cioos-pacific-bucket_default Docker network, which this
# service joins (see docker-compose.local.yml) — not http://localhost:8333.
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_BUCKET=pacific-bucket
S3_ACCESS_KEY=changeme-access-key
S3_SECRET_KEY=changeme-secret-key
AWS_REGION=us-east-1

# Shared bearer token between `erddap-sync restore` (in cioos-pacific-bucket)
# and this restore-agent. Must equal RESTORE_WEBHOOK_TOKEN in
# ../cioos-pacific-bucket/.env.
RESTORE_WEBHOOK_TOKEN=changeme-restore-token
